PORT=4000
NODE_ENV=development

# One SQLite file. Local default is api/data/sagha.db.
# On Railway or Render, mount a disk at /data and set both of these:
# SQLITE_PATH=/data/sagha.db
# SAGHA_DATA_DIR=/data
SQLITE_PATH=./data/sagha.db

# Cloud SQLite (Turso). Leave unset when using the file above.
# A postgres:// URL is rejected: this ledger is not a Postgres schema.
# LIBSQL_URL=libsql://your-db.turso.io
# LIBSQL_AUTH_TOKEN=

JWT_SECRET=dev-secret-change-me-in-production
JWT_EXPIRES_IN=12h

# Comma-separated browser origins. The phone app sends no browser origin.
# Example: https://sagha.example.com
CORS_ORIGIN=http://localhost:3000

# Password reset mail. Without SMTP_HOST, production logs an error and does not send.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Sagha <support@sagha-platform.com>

# Default gold spot (minor units per gram of fine gold)
DEFAULT_GOLD_SPOT_CENTS_PER_GRAM=7500

# Optional override for live market rates (USD per troy ounce). If unset, fetches metals.live.
# GOLD_SPOT_USD_PER_OZ=2650

# Seed admin: npm run seed:admin
ADMIN_EMAIL=admin@sagha.local
ADMIN_PASSWORD=ChangeMeNow1!
ADMIN_NAME=Sagha Admin
